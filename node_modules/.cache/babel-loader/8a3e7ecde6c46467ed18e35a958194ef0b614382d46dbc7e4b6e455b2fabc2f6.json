{"ast":null,"code":"// user.reducer.js\nimport{UPDATE_USERNAME_REQUEST,UPDATE_USERNAME_SUCCESS,UPDATE_USERNAME_FAIL}from'../actions/all.actions';const initialState={loading:false,success:false,error:null};const userReducer=function(){let state=arguments.length>0&&arguments[0]!==undefined?arguments[0]:initialState;let action=arguments.length>1?arguments[1]:undefined;switch(action.type){case UPDATE_USERNAME_REQUEST:return{...state,loading:true,success:false,error:null};case UPDATE_USERNAME_SUCCESS:return{...state,loading:false,success:true};case UPDATE_USERNAME_FAIL:return{...state,loading:false,error:action.payload};default:return state;}};export default userReducer;","map":{"version":3,"names":["UPDATE_USERNAME_REQUEST","UPDATE_USERNAME_SUCCESS","UPDATE_USERNAME_FAIL","initialState","loading","success","error","userReducer","state","arguments","length","undefined","action","type","payload"],"sources":["/Users/rineralexandre/Desktop/ArgentBankLloyd/frontend/src/redux/reducers/post.reducer.js"],"sourcesContent":["// user.reducer.js\n\nimport {\n  UPDATE_USERNAME_REQUEST,\n  UPDATE_USERNAME_SUCCESS,\n  UPDATE_USERNAME_FAIL,\n} from '../actions/all.actions';\n\nconst initialState = {\n  loading: false,\n  success: false,\n  error: null,\n};\n\nconst userReducer = (state = initialState, action) => {\n  switch (action.type) {\n    case UPDATE_USERNAME_REQUEST:\n      return { ...state, loading: true, success: false, error: null };\n    case UPDATE_USERNAME_SUCCESS:\n      return { ...state, loading: false, success: true };\n    case UPDATE_USERNAME_FAIL:\n      return { ...state, loading: false, error: action.payload };\n    default:\n      return state;\n  }\n};\n\nexport default userReducer;\n"],"mappings":"AAAA;AAEA,OACEA,uBAAuB,CACvBC,uBAAuB,CACvBC,oBAAoB,KACf,wBAAwB,CAE/B,KAAM,CAAAC,YAAY,CAAG,CACnBC,OAAO,CAAE,KAAK,CACdC,OAAO,CAAE,KAAK,CACdC,KAAK,CAAE,IACT,CAAC,CAED,KAAM,CAAAC,WAAW,CAAG,QAAAA,CAAA,CAAkC,IAAjC,CAAAC,KAAK,CAAAC,SAAA,CAAAC,MAAA,IAAAD,SAAA,MAAAE,SAAA,CAAA